#!/usr/bin/env bash
set -euo pipefail
core_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repos_root="$(dirname -- "$core_root")"
use_docker=false
if [[ "${1:-}" == --docker ]]; then use_docker=true; shift; fi
if [[ $# -gt 0 ]]; then echo "Usage: $0 [--docker]" >&2; exit 2; fi
# Both repos define the same broker. Start sequentially to avoid creation races.
for repo in power-lines-web power-lines-data-service; do
  "$repos_root/$repo/scripts/services-up"
done
if "$use_docker"; then
  (cd "$repos_root/power-lines-web" && docker compose --profile app up -d --build power-lines-web)
  echo "Web is running in Docker. Run ./data-service-run --docker --fixtures when consumers are ready."
else
  echo "Open the workspace with ./open, then run Tasks: Run Task > Local: Start all."
fi
