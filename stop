#!/usr/bin/env bash
set -euo pipefail
core_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repos_root="$(dirname -- "$core_root")"
use_docker=false
if [[ "${1:-}" == --docker ]]; then use_docker=true; shift; fi
if "$use_docker"; then
  (cd "$repos_root/power-lines-web" && docker compose --profile app stop power-lines-web "$@")
fi
for repo in power-lines-data-service power-lines-web; do
  "$repos_root/$repo/scripts/services-down" "$@"
done
echo "Shared dependencies stopped; volumes retained. Stop native apps using their VS Code tasks or Ctrl+C."
