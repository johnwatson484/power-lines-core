#!/usr/bin/env bash
set -euo pipefail
core_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repos_root="$(dirname -- "$core_root")"
for repo in power-lines-web power-lines-data-service; do
  if [[ ! -d "$repos_root/$repo" ]]; then
    git clone "https://github.com/johnwatson484/$repo.git" "$repos_root/$repo"
  fi
  (
    cd "$repos_root/$repo"
    if [[ ! -f .env ]]; then cp .env.example .env; fi
    dotnet restore "$@"
  )
done
